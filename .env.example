# Transport: stdio (default) | http
MCP_TRANSPORT=stdio
# Streamable HTTP settings (MCP_TRANSPORT=http)
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PATH=/mcp
# Comma-separated Host header allowlist when binding to 0.0.0.0 (DNS rebinding protection)
# MCP_ALLOWED_HOSTS=localhost,my-server.local

# Outbound proxy for requests to Naver (lowercase variants also work)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://user:pass@proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Optional
# NAVER_TIMEOUT_MS=15000
# NAVER_USER_AGENT=Mozilla/5.0 ...
